{
  "name": "reacteduclass",
  "version": "1.0.0",
  "description": "express react react-dom axios ",
  "main": "server.js",
  "scripts": {
    "start": "if-env NODE_ENV=production && npm run start:prod || npm run start:dev",
    "start:prod": "node server.js",
    "start:dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "client": "cd client && npm run start",
    "install": "cd client && npm install",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanganu/reacteduclass.git"
  },
  "keywords": [
    "express",
    "react",
    "dom",
    "axios"
  ],
  "author": "Sangeetha",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sanganu/reacteduclass/issues"
  },
  "homepage": "https://github.com/sanganu/reacteduclass#readme",
  "devDependencies": {
    "concurrently": "^3.5.1",
    "nodemon": "^1.18.10"
  },
  "dependencies": {
    "axios": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.2",
    "connect-mongo": "^2.0.1",
    "cookie-parser": "^1.4.3",
    "dotenv": "^5.0.1",
    "express": "^4.16.3",
    "express-session": "^1.15.6",
    "if-env": "^1.0.4",
    "mongod": "^2.0.0",
    "mongoose": "^5.0.14",
    "morgan": "^1.9.0",
    "passport": "^0.4.0",
    "passport-local": "^1.0.0",
    "request": "^2.87.0",
    "request-promise": "^4.2.2",
    "youtube-node": "^1.3.3"
  }
}
