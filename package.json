{
  "name": "classmanagement",
  "version": "1.0.0",
  "description": "Arichuvadi app MERN stack",
  "main": "server.js",
  "dependencies": {
    "axios": "^0.18.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.18.3",
    "connect-mongo": "^2.0.3",
    "cookie-parser": "^1.4.4",
    "dotenv": "^7.0.0",
    "express": "^4.16.4",
    "express-session": "^1.16.1",
    "if-env": "^1.0.4",
    "mongodb": "^3.6.2",
    "mongoose": "^5.5.2",
    "morgan": "^1.9.1",
    "passport": "^0.4.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "react-pdf": "^4.0.5",
    "react-redux": "^7.0.3",
    "redux": "^4.0.1",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "youtube-node": "^1.3.3"
  },
  "devDependencies": {
    "nodemon": "^1.18.11",
    "concurrently": "^4.1.0"
  },
  "scripts": {
    "start": "if-env NODE_ENV=production && npm run start:prod || npm run start:dev",
    "start:prod": "node server.js",
    "start:dev": "concurrently \"nodemon --ignore 'client/*'\" \"npm run client\"",
    "client": "cd client && npm run start",
    "seed": "node scripts/seedDB.js",
    "install": "cd client && npm install",
    "build": "cd client && npm run build",
    "heroku-postbuild": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://Sangkal@bitbucket.org/Sangkal/clmgnt.git"
  },
  "keywords": [
    "Express",
    "Mango",
    "React",
    "Mongoose",
    "Passport",
    "local"
  ],
  "author": "SangeethaKp",
  "license": "MIT",
  "homepage": "https://bitbucket.org/Sangkal/clmgnt#readme"
}
